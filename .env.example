# -----------------------------------------------------------------------------
# SERVER CONFIGURATION
# -----------------------------------------------------------------------------
PORT=5000
NODE_ENV=development # Accepted values: development, production

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION (Identity-Core)
# -----------------------------------------------------------------------------
# Standard PostgreSQL connection string.
# Replace <user> and <your-password> with your local PostgreSQL credentials
DATABASE_URL="postgresql://<user>:<your-password>@localhost:5432/identity_core?schema=public"

# -----------------------------------------------------------------------------
# DATABASE CONNECTION POOLING (Architectural Guardrails)
# -----------------------------------------------------------------------------
# MAX: How many simultaneous conversations with the DB.
# Set to 20 to handle high concurrency while protecting DB resources.
DB_POOL_MAX=20

# CONNECTION TIMEOUT: Time to wait for a pipe (in ms).
# 5000ms ensures we fail fast if the DB is under heavy load or offline.
DB_CONNECTION_TIMEOUT=5000

# IDLE TIMEOUT: Time before closing unused pipes (in ms).
# 30000ms (30s) keeps the pool 'warm' for active users but saves RAM during downtime.
DB_IDLE_TIMEOUT=30000

# MAX LIFETIME: Force retirement of old pipes (in seconds).
# 1800s (30m) ensures fresh connections and helps auto-discover new DB nodes after a crash.
DB_MAX_LIFETIME=1800